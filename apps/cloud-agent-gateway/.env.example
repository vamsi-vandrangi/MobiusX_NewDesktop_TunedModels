# Copy this file to `.env` (same directory) and fill in your own values to
# make MobiusX Cloud Gateway use a real Anthropic model instead of the
# deterministic demo runner. `.env` is already gitignored at the repo root —
# your key never gets committed. Leave `.env` absent (or these two blank) to
# keep using the demo runner; see README.md for what each runner does.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
