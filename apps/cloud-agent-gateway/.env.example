# Copy this file to `.env` (same directory) and fill in your own values to
# make MobiusX Cloud Gateway use a real Anthropic model instead of the
# deterministic demo runner. `.env` is already gitignored at the repo root —
# your key never gets committed. Leave `.env` absent (or these two blank) to
# keep using the demo runner; see README.md for what each runner does.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional: free-tier providers for the multi-model picker (Settings default
# + per-task override in the AI Assistant panel). Leave blank to just see
# them listed as unavailable in GET /models -- nothing breaks if you skip
# some or all of these.
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Local Ollama install (https://ollama.com) -- no API key. Only needed if
# Ollama runs somewhere other than its default localhost port.
OLLAMA_BASE_URL=

# Optional: free-tier providers for the multi-model picker (Settings default
# + per-task override in the AI Assistant panel). Leave blank to just see
# them listed as unavailable in GET /models -- nothing breaks if you skip
# some or all of these.
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Local Ollama install (https://ollama.com) -- no API key. Only needed if
# Ollama runs somewhere other than its default localhost port.
OLLAMA_BASE_URL=

# Optional: free-tier providers for the multi-model picker (Settings default
# + per-task override in the AI Assistant panel). Leave blank to just see
# them listed as unavailable in GET /models -- nothing breaks if you skip
# some or all of these.
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Local Ollama install (https://ollama.com) -- no API key. Only needed if
# Ollama runs somewhere other than its default localhost port.
OLLAMA_BASE_URL=

# Optional: free-tier providers for the multi-model picker (Settings default
# + per-task override in the AI Assistant panel). Leave blank to just see
# them listed as unavailable in GET /models -- nothing breaks if you skip
# some or all of these.
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Local Ollama install (https://ollama.com) -- no API key. Only needed if
# Ollama runs somewhere other than its default localhost port.
OLLAMA_BASE_URL=
