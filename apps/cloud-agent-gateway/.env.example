# Copy this file to `.env` (same directory) and fill in your own values to
# make MobiusX Cloud Gateway use a real Anthropic model instead of the
# deterministic demo runner. `.env` is already gitignored at the repo root —
# your key never gets committed. Leave `.env` absent (or these two blank) to
# keep using the demo runner; see README.md for what each runner does.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional: free-tier providers for the multi-model picker (Settings default
# + per-task override in the AI Assistant panel). Leave blank to just see
# them listed as unavailable in GET /models -- nothing breaks if you skip
# some or all of these.
OPENROUTER_API_KEY=
GROQ_API_KEY=
XKIRO_API_KEY=
APINEX_API_KEY=
# Local Ollama install (https://ollama.com) -- no API key. Only needed if
# Ollama runs somewhere other than its default localhost port.
OLLAMA_BASE_URL=
# Ollama chat has a bounded, independent wait for response headers. The
# default is 15 minutes (maximum 20 minutes); the task deadline still applies.
MOBIUSX_OLLAMA_HEADERS_TIMEOUT_MS=900000
# Local generations are serialized by default; the pending queue is bounded.
MOBIUSX_OLLAMA_MAX_CONCURRENCY=1
MOBIUSX_OLLAMA_MAX_QUEUE=4
MOBIUSX_OLLAMA_STREAM_IDLE_TIMEOUT_MS=180000
# Request bodies can include proprietary source and user prompts. Content is
# never written to diagnostics unless this explicit opt-in is enabled and the
# chosen directory is private (owner-only permissions). Hash/size metadata is
# recorded even when capture is disabled.
MOBIUSX_OLLAMA_CAPTURE_REQUESTS=0
# Raw model responses may contain generated source. Capture is disabled by default;
# when explicitly enabled, files are stored mode 0600 in the owner-only directory above.
MOBIUSX_OLLAMA_CAPTURE_RESPONSES=0
# MOBIUSX_OLLAMA_CAPTURE_DIR=/private/tmp/mobiusx-ollama-request-captures
# Keep num_ctx stable across a task so Ollama can reuse the same loaded runner.
# The default is 12288 and accepted values are clamped to 8192..16384 tokens.
MOBIUSX_OLLAMA_NUM_CTX=12288
# Local inference execution deadlines. Values are milliseconds and are clamped
# to safe maxima. Build defaults to 30 minutes because a measured CPU-only
# Qwen response reached 2,237 tokens/9.7 KB at 20 minutes but had not closed
# its structured bundle. Staged repair defaults to 35 minutes after a focused
# repair produced partial output at its old 20-minute limit.
MOBIUSX_OLLAMA_BUILD_TIMEOUT_MS=1800000
MOBIUSX_OLLAMA_REPAIR_TIMEOUT_MS=240000
MOBIUSX_OLLAMA_STAGED_REPAIR_TIMEOUT_MS=2100000
# Directly run an explicitly selected Build model without waiting for Laya.
# Set false only to restore optional Laya classification for explicit builds.
MOBIUSX_BYPASS_LAYA_FOR_EXPLICIT_BUILD=true
