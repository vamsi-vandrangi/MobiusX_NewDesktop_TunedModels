{
  "name": "@mobiusx/desktop-shell",
  "productName": "MobiusX.ai",
  "version": "0.0.1",
  "private": true,
  "description": "MobiusX Desktop shell — Engineering Studio / X-Coder workspace (Phase 1 v0)",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/brand-electron-mac.js",
    "build:services": "npm run build --workspaces --if-present --prefix ../..",
    "prepare:resources": "node scripts/prepare-resources.js",
    "build:hljs-bundle": "node scripts/build-hljs-bundle.js",
    "pack:mac": "npm run build:services && npm run prepare:resources && electron-builder --mac --publish=never",
    "pack:win": "npm run build:services && npm run prepare:resources && electron-builder --win --publish=never",
    "pack": "npm run build:services && npm run prepare:resources && electron-builder --mac --win --publish=never",
    "release": "npm run build:services && npm run prepare:resources && electron-builder --mac --win --publish=always"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "pe-library": "^2.0.1",
    "resedit": "^3.1.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^7.0.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "mermaid": "^12.0.0"
  },
  "build": {
    "appId": "ai.mobiusx.desktop",
    "afterSign": "scripts/fix-windows-icon.js",
    "productName": "MobiusX.ai",
    "copyright": "Copyright © CadenceX Technologies",
    "protocols": [
      {
        "name": "MobiusX.ai",
        "schemes": [
          "mobiusx"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!resources-staging",
      "!scripts/prepare-resources.js"
    ],
    "extraResources": [
      {
        "from": "resources-staging/apps",
        "to": "apps"
      },
      {
        "from": "resources-staging/node_modules",
        "to": "node_modules"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/electron.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "MobiusX.ai ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vamsi-vandrangi",
        "repo": "MobiusX_WDC"
      }
    ],
    "electronVersion": "33.4.11",
    "npmRebuild": false
  }
}
