node_modules/
dist/
build/
out/
.DS_Store
*.log
.env
.env.local
.mobiusx-index/

# Demo/scratch projects created by using the app itself (Build/New Project),
# not part of the platform's own source -- see docs/phase-notes.
/Test Projects/

# Packaging: staged sibling-service bundle and electron-builder's output --
# both regenerated by apps/desktop's pack:mac/pack:win/pack scripts, never
# hand-edited or committed. See apps/desktop/scripts/prepare-resources.js.
/apps/desktop/resources-staging/
/apps/desktop/release/

# Leftovers this mount's delete restriction can force onto disk when a
# packaging attempt is interrupted (rename-away-instead-of-delete is the
# workaround used throughout this repo's history) -- always safe to ignore
# and safe to actually delete by hand once no longer needed.
*.stale-*
*.stale[0-9]-*
